# Copy this file to .env and fill in your real values. .env is git-ignored.

# Your Notion internal integration token (starts with "secret_" or "ntn_")
NOTION_TOKEN=your_notion_integration_token_here

# OPTIONAL: pin your 7 day-page IDs here to skip auto-discovery.
# Leave blank and the script will find pages named Monday..Sunday that are
# shared with your integration.
NOTION_PAGE_MONDAY=
NOTION_PAGE_TUESDAY=
NOTION_PAGE_WEDNESDAY=
NOTION_PAGE_THURSDAY=
NOTION_PAGE_FRIDAY=
NOTION_PAGE_SATURDAY=
NOTION_PAGE_SUNDAY=
